# AWS — uses boto3's default credential chain. Set one of:
#   AWS_PROFILE (matches a profile in config/providers.yaml), or
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
AWS_PROFILE=default

# Azure — adapter is currently stubbed (see src/providers/azure_provider.py).
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GCP — adapter is currently stubbed (see src/providers/gcp_provider.py).
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: webhook approval channel (see src/approval.py) — if set, the
# approval store can be written to by an external webhook receiver that
# posts decisions in the same schema as state/approvals.json.
APPROVAL_WEBHOOK_URL=
